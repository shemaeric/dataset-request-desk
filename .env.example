# Copy to .env only to override Compose. Placeholders for local use. Do not commit .env.

POSTGRES_USER=desk
POSTGRES_PASSWORD=desk
POSTGRES_DB=dataset_request_desk

# Published host ports. Container ports stay 5432, 8000, and 80.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080

# Hostname `db` is the Compose service name. The API process does not read this yet.
DATABASE_URL=postgresql+psycopg://desk:desk@db:5432/dataset_request_desk
